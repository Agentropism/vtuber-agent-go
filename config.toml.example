[server]
addr = ":8080"

[log]
level = "info"

[llm]
# OpenAI 兼容端点；DeepSeek 用 https://api.deepseek.com/v1
base_url = "https://api.deepseek.com/v1"
# 凭据不进仓库：此处留空则读环境变量 LLM_API_KEY
api_key = ""
model = "deepseek-chat"
# 采样温度，0 表示使用默认值 1.0
temperature = 0.7

[agent]
# 角色定义文件（TOML，见 characters/mili.toml）；非空时其 system_prompt 优先于下面这行
character_file = "characters/mili.toml"
# 角色系统提示词；character_file 为空时使用，两者都为空时用内置兜底值
system_prompt = "你是一个活泼可爱的女性 AI VTuber，名字叫 Mili。用简短、口语化的方式回复，每次回复不超过两句话。"
# 单轮对话超时，例如 "60s"
turn_timeout = "60s"
# 每个会话（每个群 / 每个直播间）的待处理消息上限
queue_size = 16
# 单轮对话内工具循环上限，0 = 使用默认值 8
max_tool_rounds = 8
# 打断标记写入历史的角色：user（默认，所有端点可用）/ system
interrupt_mode = "user"
# 历史裁剪：只保留最近 N 轮对话，0 = 使用默认值 12
history_max_turns = 12
# 历史裁剪：估算 token 上限（中文 1 字≈1 token，其余 4 字符≈1 token），0 = 使用默认值 4000
history_max_tokens = 4000
# 长期记忆文件（JSON Lines）；为空表示不启用记忆与召回
memory_file = "data/memory.jsonl"
# 每轮对话召回的条数，0 = 使用默认值 5
recall_limit = 5
# 对话归档目录（JSON Lines，只增不删，按平台/渠道分类）；为空表示不启用归档
#   data/chats/local/room_local.jsonl · data/chats/qq/group_*.jsonl · data/chats/bilibili/room_*.jsonl
archive_dir = "data/chats"
# 渠道首次创建时从归档恢复的对话轮数（重启后接得上上文），0 = 不恢复
history_rehydrate_turns = 12
# 打开工具调用：记忆检索（memory_search）与状态查询（bot_status）
enable_tools = true
# 渠道静默超过该时长就主动说一句，例如 "5m"；"0s" = 不主动发言
idle_speak_interval = "0s"
# 主动发言时给模型的提示词，留空用内置兜底
idle_speak_prompt = ""

[tts]
# 引擎降级顺序，按序降级；留空表示不启用语音播报（只做文本回复）
engines = ["edge_tts"]

[tts.edge_tts]
# 微软 Edge 朗读：免费、无需 key，但属社区逆向协议，有地区封锁风险
# 音色留空则用默认 zh-CN-XiaoxiaoNeural（中文女声）
voice = ""
rate = "+0%"
volume = "+0%"
pitch = "+0Hz"
# 显式代理；留空时读环境变量 HTTP_PROXY / HTTPS_PROXY
proxy = ""
# 拨号与接收超时（秒）
receive_timeout = 30

[tts.openai_tts]
base_url = "https://api.openai.com/v1"
# 留空则读环境变量 OPENAI_API_KEY
api_key = ""
model = "tts-1"
voice = "alloy"
# 语速，0 表示不下发该字段
speed = 0

[tts.siliconflow_tts]
base_url = "https://api.siliconflow.cn/v1"
# 留空则读环境变量 SILICONFLOW_API_KEY
api_key = ""
model = "FunAudioLLM/CosyVoice2-0.5B"
voice = "speech:Dreamflowers:5bdstvc39i:xkqldnpasqmoqbakubom"
speed = 0
# 采样率固定 24000 以对齐 PCM 契约；gain 为音量增益，0 表示不下发
sample_rate = 24000
gain = 0

[tts.fish_api_tts]
base_url = "https://api.fish.audio"
# 留空则读环境变量 FISH_API_KEY
api_key = ""
model = ""
# 音色模型 ID
reference_id = ""
latency = "balanced"
sample_rate = 24000

[tts.minimax_tts]
base_url = "https://api.minimax.chat"
group_id = ""
# 留空则读环境变量 MINIMAX_API_KEY
api_key = ""
model = "speech-02-turbo"
voice_id = "female-shaonv"
sample_rate = 24000

[broadcast]
# 并行合成上限：一段在播时提前合成下一段，降低首字延迟
concurrency = 2
# 待合成条目上限，超出时淘汰最低优先级
max_pending = 32
# 两次播报之间的最小间隔，例如 "2s"；0 表示不限
min_interval = "0s"

[memory]
# 上传缓存容量（默认 256，0 也按 256 处理）
queue_size = 256
# 缓存满时的等待上限，0 = 无限等待（背压）；例如 "10s"
queue_wait_timeout = "0s"
# 敏感词库文件路径（UTF-8，每行一个词，# 开头为注释）；为空则不启用过滤
sensitive_words_file = ""
# 消息去重窗口，例如 "600s"；0 = 不启用
dedup_ttl = "600s"

[frontend]
# 前端接入（根路径页面 + /api/client-ws 长连接 + /api/models/ 模型资源）；配了模型目录即自动启用
enabled = false
# Live2D 模型根目录，结构为 <模型名>/runtime/<模型名>.model3.json
models_dir = "../Open-LLM-VTuber/live2d-models"
# 模型清单（提供缩放、偏移与 emotionMap）；留空则扫描模型目录、用内置兜底词表
model_dict = "../Open-LLM-VTuber/model_dict.json"
# 模型显示倍率：1.0 = 正好占满视口高度；0 = 沿用模型清单里的值
model_scale = 0.8

[[clients]]
platform = "qq"
adapter_key = "onebot_v11"
path = "/qq"

[[clients]]
platform = "bilibili"
adapter_key = "bilibili_live"
path = "/bilibili"

# B 站接入由外部上报端负责（连开放平台、鉴权、心跳、重连、拆帧），
# 因此这里没有 [bilibili] 凭据段——凭据配在上报端自己的配置里。
# 上报端要求与本仓删除的 Go 客户端修正过的已知坑见 docs/BILIBILI_INGEST.md。

# 推流：把画面与声音推到 RTMP，替代 OBS。开启后链路是——
#   1) 用下面的 cookie 与 room_id 调 B 站 web 接口开播，拿回推流地址与密钥；
#   2) 本进程起 Xvfb 虚拟屏 + Chrome 全屏跑根路径页面当画面；
#   3) ffmpeg 抓屏 + 播报队列的 PCM → RTMP。
# 进程退出时会调关播接口。只要 output 填了完整地址，就跳过第 1 步直接用这个地址。
[stream]
enabled = false
output = ""
# B 站登录态（能开播、能发弹幕的凭据）。两个来源，任选其一：
#   1) 推荐：起服务后浏览器打开 http://127.0.0.1:<端口>/login/ 扫码，登录态自动落盘；
#   2) 手动：浏览器里复制整条 Cookie 填这里，至少含 SESSDATA 与 bili_jct。
# 这里留空时回退环境变量 BILIBILI_COOKIE；两者都空就用扫码登录落盘的文件。
cookie = ""
# 扫码登录的落盘路径，留空用 data/bilibili-cookie.txt（权限 0600，别提交）
cookie_file = ""
# 直播间号（不是用户 uid）
room_id = 0
# 分区 id，留空表示沿用直播间当前分区
area_id = ""
# 画面来源：screen=抓虚拟屏（正常用法），test=ffmpeg 测试画面（自检用，不需要虚拟屏）
input = "screen"
# 是否由本进程起虚拟屏与浏览器；显示与浏览器已自备（如手动起了 Xvfb）时置 false
renderer = true
display = ":99"
xvfb = "Xvfb"
chrome = "google-chrome-stable"
# 尺寸与帧率直接决定 Chrome 的 CPU 开销（虚拟屏无 GPU，渲染走软件）：
#   1280x720@30 实测 Chrome 吃 7 个核，会把 x264 饿到 0.86 倍速、码率掉到 37k，
#   被服务端判为涓流后约 12 秒掐断连接；640x360@15 稳定（Chrome ~3.7 核）。
# 开着推流时先用 top 看一眼，Chrome 长期 100% 以上就往下调。
width = 640
height = 360
fps = 15
video_bitrate = "1200k"
audio_bitrate = "64k"
# 有 N 卡可换 h264_nvenc
encoder = "libx264"
ffmpeg = "ffmpeg"
# ffmpeg 异常退出后的重启间隔；"0s" 用默认 5s，负数表示不重启
restart_wait = "5s"
