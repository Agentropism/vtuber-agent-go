# 运行时配置：里面有 B 站 access key、LLM key 等凭据，不进仓库。
# 模板见 config.toml.example，新环境复制一份再填。
config.toml

# 长期记忆与运行时数据
data/

# 就地编译出来的二进制
/vtuber-agent-go

# 本机工具状态（pi / claude / codegraph），不属于项目交付物
.pi/
.claude/
.codegraph/

# 运行时配置的备份：同样含凭据，绝不能进仓库
config.toml.bak
config.toml.*.bak

# 前端源码产物：由 go generate 从顶层 frontend/ 同步（单一事实源），只跟踪占位文件。
/internal/backend/web/assets/*
!/internal/backend/web/assets/.gitkeep
