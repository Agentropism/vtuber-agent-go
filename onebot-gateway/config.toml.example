[server]
addr = ":8080"

[log]
level = "info"

[llm]
# OpenAI 兼容端点；DeepSeek 用 https://api.deepseek.com/v1
base_url = "https://api.deepseek.com/v1"
# 凭据不进仓库：此处留空则读环境变量 LLM_API_KEY
api_key = ""
model = "deepseek-chat"
# 采样温度，0 表示使用默认值 1.0
temperature = 0.7

[agent]
# 角色系统提示词；为空时使用内置兜底值
system_prompt = "你是一个活泼可爱的女性 AI VTuber，名字叫 Mili。用简短、口语化的方式回复，每次回复不超过两句话。"
# 单轮对话超时，例如 "60s"
turn_timeout = "60s"
# 每个会话（每个群 / 每个直播间）的待处理消息上限
queue_size = 16
# 单轮对话内工具循环上限，0 = 使用默认值 8
max_tool_rounds = 8
# 打断标记写入历史的角色：user（默认，所有端点可用）/ system
interrupt_mode = "user"

[memory]
# 已废弃：事件终端已改为进程内 agent 会话，不再有远程 WebSocket 目标。
# target / callback_platform 两个键保留仅为兼容旧配置文件，不再被读取。
# target = "ws://127.0.0.1:12393/proxy-ws"
# callback_platform = "qq"
target = "ws://127.0.0.1:12393/proxy-ws"
# 记忆服务下行 Action 的目标客户端平台
callback_platform = "qq"
# 上传缓存容量（默认 256，0 也按 256 处理）
queue_size = 256
# 缓存满时的等待上限，0 = 无限等待（背压）；例如 "10s"
queue_wait_timeout = "0s"
# 敏感词库文件路径（UTF-8，每行一个词，# 开头为注释）；为空则不启用过滤
sensitive_words_file = ""
# 消息去重窗口，例如 "600s"；0 = 不启用
dedup_ttl = "600s"

[bilibili]
# 礼物、醒目留言和大航海事件的语音反馈端点；空字符串表示禁用
distillery_target = "http://127.0.0.1:9528/event"

[[clients]]
platform = "qq"
adapter_key = "onebot_v11"
path = "/qq"

[[clients]]
platform = "bilibili"
adapter_key = "bilibili_live"
path = "/bilibili"
